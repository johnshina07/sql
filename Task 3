SELECT * FROM sellers;

SELECT * FROM products;

SELECT * FROM inventory;

SELECT
    s.seller_id,
    s.seller_name,
    p.product_id,
    p.product_name,
    p.category,
    p.price,
    i.stock_quantity,
    i.status
FROM sellers s
JOIN inventory i
ON s.seller_id = i.seller_id
JOIN products p
ON i.product_id = p.product_id;

SELECT
    s.seller_name,
    p.product_name,
    p.category,
    p.price,
    i.stock_quantity,
    i.status
FROM sellers s
JOIN inventory i
ON s.seller_id = i.seller_id
JOIN products p
ON i.product_id = p.product_id
WHERE i.stock_quantity > 0;

SELECT
    s.seller_name,
    p.product_name,
    p.category,
    p.price,
    i.stock_quantity,
    i.status
FROM sellers s
JOIN inventory i
ON s.seller_id = i.seller_id
JOIN products p
ON i.product_id = p.product_id
WHERE i.stock_quantity = 0;

UPDATE inventory
SET stock_quantity = 20,
    status = 'Available'
WHERE inventory_id = 4;

UPDATE inventory
SET status = CASE
    WHEN stock_quantity > 0 THEN 'Available'
    ELSE 'Unavailable'
END
WHERE inventory_id > 0;

SELECT
    i.inventory_id,
    s.seller_name,
    p.product_name,
    p.category,
    p.price,
    i.stock_quantity,
    i.status
FROM inventory i
JOIN sellers s
ON i.seller_id = s.seller_id
JOIN products p
ON i.product_id = p.product_id
ORDER BY i.inventory_id;

SELECT
    s.seller_name,
    SUM(i.stock_quantity) AS total_stock
FROM sellers s
JOIN inventory i
ON s.seller_id = i.seller_id
GROUP BY s.seller_id, s.seller_name;

SELECT
    status,
    COUNT(*) AS product_count
FROM inventory
GROUP BY status;

SELECT
    s.seller_name,
    p.product_name,
    i.stock_quantity
FROM sellers s
JOIN inventory i
ON s.seller_id = i.seller_id
JOIN products p
ON i.product_id = p.product_id
WHERE i.stock_quantity > 0
AND i.stock_quantity <= 10;

SELECT
    i.inventory_id AS Inventory_ID,
    s.seller_name AS Seller_Name,
    p.product_name AS Product_Name,
    p.category AS Category,
    p.price AS Price,
    i.stock_quantity AS Stock_Quantity,
    CASE
        WHEN i.stock_quantity > 0 THEN 'Available'
        ELSE 'Unavailable'
    END AS Status
FROM inventory i
INNER JOIN sellers s
ON i.seller_id = s.seller_id
INNER JOIN products p
ON i.product_id = p.product_id
ORDER BY i.inventory_id;
